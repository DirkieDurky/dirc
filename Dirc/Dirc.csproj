<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="HAL/Diric/runtime-diric/**/*" CopyToOutputDirectory="Always">
      <Link>lib/runtime-diric/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="HAL/X86/runtime-x86/**/*" CopyToOutputDirectory="Always">
      <Link>lib/runtime-x86/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="HAL/Diric/stdlibcore-diric/Compiled/**/*" CopyToOutputDirectory="Always">
      <Link>lib/stdlibcore-diric/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="HAL/X86/stdlibcore-x86/Compiled/**/*" CopyToOutputDirectory="Always">
      <Link>lib/stdlibcore-x86/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="HAL/Diric/stdlib-diric/**/*" CopyToOutputDirectory="Always">
      <Link>lib/stdlib-diric/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="HAL/X86/stdlib-x86/**/*" CopyToOutputDirectory="Always">
      <Link>lib/stdlib-x86/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

</Project>
